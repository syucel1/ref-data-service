<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" shutdownHook="disable">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %logger{1} %X - %msg%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Logger name="io.netty" level="${sys:rds.log.netty.level:-WARN}"/>
    <Logger name="com.example.refdata.client" level="${sys:rds.log.client.level:-INFO}"/>
    <Logger name="com.example.refdata.server.sessions" level="${sys:rds.log.sessions.level:-INFO}"/>
    <Root level="${sys:rds.log.level:-INFO}"><AppenderRef ref="Console"/></Root>
  </Loggers>
</Configuration>
